{
  "name": "pi-agent-switcher",
  "version": "0.4.0-rodrigo.2",
  "description": "Searchable primary-agent picker with skill profiles and delegation to Rodrigo's Pi subagents",
  "type": "module",
  "main": "index.ts",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigojager/pi-agent-switcher.git"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "*.ts",
    "README.md",
    "CHANGES.md",
    "UPSTREAM.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^26.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "dependencies": {
    "pi-subagent-runtime": "github:rodrigojager/pi-subagent#26f229a4be5691a04ce68dfb978c4042a7376cf0"
  }
}
